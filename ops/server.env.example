# ==============================================================================
# YACA Home Server - Environment Configuration Example
# ==============================================================================
# Copia questo file in '/srv/yaca/.env' sul server di destinazione e popola i valori.
# Proteggi il file con permessi restrittivi: chmod 600 /srv/yaca/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & RETE
# ------------------------------------------------------------------------------
# Porta interna su cui ascolta il server Express dentro il container.
# Mappata su 127.0.0.1:7860 nel docker-compose.yml.
PORT=7860

# URL pubblico HTTPS con cui l'addon risponde al mondo esterno.
# Con Tailscale Funnel corrisponde a: https://<nome-nodo>.<tailnet>.ts.net
# Sostituisce definitivamente la vecchia variabile SPACE_HOST.
HOST_URL=https://<nome-nodo>.<tailnet>.ts.net

# Ambiente di esecuzione Node.js
NODE_ENV=production

# Tag dell'immagine Docker pubblicata su GitHub Container Registry (GHCR).
# Default: 'latest', oppure un commit SHA specifico (es. YACA_TAG=45bd78f).
YACA_TAG=latest

# ------------------------------------------------------------------------------
# 2. CACHE & DATABASE
# ------------------------------------------------------------------------------
# URL del container Redis per cache L1/L2 in-memory (gestito da docker-compose).
REDIS_URL=redis://redis:6379

# URI di connessione al cluster MongoDB Atlas M0 (solo dati permanenti utente).
# Formato: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/yaca?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/yaca?retryWrites=true&w=majority

# Disattiva il salvataggio dei SystemLog su MongoDB Atlas per risparmiare storage M0 e I/O WAN.
# I log sono gestiti nativamente da Docker ('docker compose logs -f app').
# Log applicativi: console (default) oppure mongo
SYSTEM_LOG=console

# ------------------------------------------------------------------------------
# 3. SICUREZZA & AUTENTICAZIONE
# ------------------------------------------------------------------------------
# Stringa crittografica casuale per la firma e verifica dei token di sessione JWT.
# Generabile con: openssl rand -hex 32
JWT_SECRET=inserisci_un_segreto_casuale_di_almeno_32_caratteri

# Password di accesso al pannello di amministrazione e alle route protette (/api/admin/*).
ADMIN_PASS=inserisci_una_password_amministratore_forte

# ------------------------------------------------------------------------------
# 4. CHIAVI API ESTERNE (METADATI & AI)
# ------------------------------------------------------------------------------
# API Key v3 di TheMovieDatabase (TMDB), indispensabile per il cold start del catalogo DuckDB.
TMDB_API_KEY=inserisci_la_tua_tmdb_api_key_v3

# --- Cold start del dump TMDB (prestazioni) ---
# Richieste in volo durante il cold start. 1 = sequenziale (~3 giorni per 533k titoli),
# 8 = ~9 ore. Alzare con cautela: il limite pratico è TMDB + la banda di casa.
TMDB_DUMP_CONCURRENCY=8

# Pausa (ms) fra un gruppo di richieste e il successivo: rate limiting verso TMDB.
TMDB_DUMP_DELAY_MS=285

# API Key di Mistral AI, utilizzata per il motore di raccomandazioni intelligenti.
MISTRAL_API_KEY=inserisci_la_tua_mistral_api_key

# ------------------------------------------------------------------------------
# 5. INTEGRAZIONI TERZE (TRAKT, TORRENTIO, DEBRID)
# ------------------------------------------------------------------------------
# Client ID dell'applicazione Trakt.tv per autenticazione OAuth e scrobble.
TRAKT_CLIENT_ID=inserisci_il_tuo_trakt_client_id

# Client Secret dell'applicazione Trakt.tv.
TRAKT_CLIENT_SECRET=inserisci_il_tuo_trakt_client_secret

# URL base del provider Torrentio per la risoluzione dei flussi torrent/debrid.
TORRENTIO_URL=https://torrentio.strem.fun

# URL opzionale per proxy addon Stremio (lasciare vuoto se non utilizzato).
PROXY_ADDON_URL=

# Configurazione opzionale Easy Debrid (lasciare vuoto se non utilizzato).
ERDB_CONFIG=

# ------------------------------------------------------------------------------
# 6. BACKUP & STORAGE CLOUDFLARE R2 (rclone)
# ------------------------------------------------------------------------------
# Destinazione remota (o percorso locale) per i backup MongoDB e database locali.
# Usata sia da 'ops/yaca-backup.sh' che da 'ops/yaca-dump-backup.sh'.
# Formato: <nome_remote_rclone>:<nome_bucket> oppure /percorso/locale (es. /srv/yaca/backups-local)
R2_DESTINATION=r2:yaca-backups

# Retention in giorni per i dump MongoDB Atlas e i file leggeri dei database locali
# (parquet TMDB, cursor.json, cache serie anime). Default: 30 giorni.
BACKUP_RETENTION_DAYS=30

# Retention in giorni per i dump JSONL completi TMDB (master_movies.jsonl, master_tv.jsonl)
# generati dal timer settimanale con flag '--full'. Default: 21 giorni (3 settimane).
JSONL_RETENTION_DAYS=21

# Parametri facoltativi utili alla configurazione di rclone (rclone.conf):
R2_ACCOUNT_ID=tuo_account_id_cloudflare
R2_ACCESS_KEY_ID=tua_access_key_r2
R2_SECRET_ACCESS_KEY=tua_secret_access_key_r2
R2_BUCKET=yaca-backups

# ==============================================================================
# VARIABILI DEPRECATE / NON PIÙ NECESSARIE (NON CONFIGURARE):
# ==============================================================================
# Le seguenti variabili d'ambiente appartenevano al vecchio hosting (dismesso)
# e non servono più sul server:
#   - HF_TOKEN, HF_SPACE_ID, HF_BUCKET_NAME, HF_ACCESS_TOKEN (dismesse: rimosse)
#   - SPACE_HOST       (obsoleta: sostituita da HOST_URL)
# ==============================================================================
