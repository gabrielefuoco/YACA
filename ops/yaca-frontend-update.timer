# YACA — controllo periodico dell'export statico del frontend.
# Ogni 5 minuti: se l'asset pubblicato ha lo stesso `version.json` gia' servito, non fa niente.
[Unit]
Description=YACA - controllo ogni 5 minuti dell'export statico

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=yaca-frontend-update.service

[Install]
WantedBy=timers.target
