[Unit]
# ==============================================================================
# YACA - Aggiornamento notturno del grafo (nuovi titoli dal daemon TMDB)
# ==============================================================================
# Non scarica niente: legge i parquet che `tmdb-daemon` ha gia' scritto sul volume
# e i mapping anime gia' presenti. Se il dump e' fermo da oltre 36 ore non tocca
# niente e lo scrive nel journal.
#
# Gira DOPO il backup notturno (04:30) e dopo un ciclo del daemon (orario):
# alle 05:30 i parquet della notte sono gia' sul disco.
#
# Primo avvio a mano, per verificare che il delta sia quello atteso:
#   sudo systemctl start yaca-grafo.service
#   journalctl -u yaca-grafo -n 50 --no-pager
Description=YACA Graph Nightly Update (nuovi titoli, studente, tipi, artefatto)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/srv/yaca/.env
WorkingDirectory=/srv/yaca
ExecStart=/usr/bin/env python3 -m services.graph_dense.aggiorna
StandardOutput=journal
StandardError=journal
# e' un job di notte: non deve rubare CPU al prodotto
Nice=10
IOSchedulingClass=idle
# il primo giro puo' durare ~20 minuti (metadati 12 + tipi 5 + chiusura 5)
TimeoutStartSec=5400

[Install]
WantedBy=multi-user.target
