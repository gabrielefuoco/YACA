# ── Runtime del server ───────────────────────────────────────────
# Porta interna del container: deve combaciare con la mappatura in docker-compose.yml
PORT=7860

# URL pubblico da cui l'addon è raggiungibile (Tailscale Funnel, o dominio se un giorno ce l'hai).
# Necessario per generare correttamente gli URL dei poster con badge episodio.
# HOST_URL=https://matebook.<tuo-tailnet>.ts.net

# Redis: nel compose è il servizio `redis` (nome host interno alla rete Docker)
REDIS_URL=redis://redis:6379

# Log applicativi: console (default, zero quota su Atlas M0) oppure mongo
# SYSTEM_LOG=console

# ── Dati ────────────────────────────────────────────────────────
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/yaca
# TMDB_API_KEY=
# MISTRAL_API_KEY=   (BYOK only — server fallback disabilitato per AI generation)
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=

# ── Auth ────────────────────────────────────────────────────────
# JWT_SECRET=   genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ADMIN_PASS=

# ── Opzionale ───────────────────────────────────────────────────
# CORS_ALLOWED_ORIGINS=https://miosito.com,https://altro.com
# TORRENTIO_URL=
