# ╔══════════════════════════════════════════════════════════════════╗
# ║  YACA — inventario dei segreti                                 ║
# ║                                                                ║
# ║  ⚠️ La CI non usa più segreti GitHub: il deploy costruisce     ║
# ║     l'immagine e la pusha su GHCR, senza toccare il server.    ║
# ║                                                                ║
# ║  I valori qui elencati servono sul SERVER, nel file            ║
# ║  /srv/yaca/.env (chmod 600). Vedi ops/server.env.example.      ║
# ║                                                                ║
# ║  Copia questo file come secrets.env e compila se ti serve      ║
# ║  tenerne traccia in locale. NON committare secrets.env.        ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── OBBLIGATORI SUL SERVER ───────────────────────────────────────

# Database (Atlas M0 resta la casa dei dati utente)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/yaca

# TMDB (cataloghi, metadati e cold start dei parquet)
TMDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth
JWT_SECRET=una-stringa-segreta-lunga-e-casuale
ADMIN_PASS=una-password-admin-lunga

# URL pubblico (Tailscale Funnel)
HOST_URL=https://matebook.<tuo-tailnet>.ts.net

# ── OPZIONALI ────────────────────────────────────────────────────

# AI Discovery (catalogo AI)
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Trakt (sincronizzazione watchlist)
# TRAKT_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TRAKT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OBSOLETI (vecchio hosting dismesso, non servono più) ─────────
# HF_TOKEN=
# HF_SPACE_ID=
# HF_BUCKET_NAME=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# ERDB_CONFIG=
# PROXY_ADDON_URL=
